GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Request Timeouts & Single Bounded Retry Settings
GEMINI_TIMEOUT_SECONDS=25
GEN_MAX_RETRIES=3
GEN_TOTAL_BUDGET_SECONDS=40
# GEN_THINKING_LEVEL=MINIMAL  # Optional: MINIMAL, LOW, MEDIUM, HIGH (unset = model default)

# Contract Analysis Configuration
MAX_ANALYSIS_CHARS=60000
MAX_ANALYSES_PER_SESSION=10
MIN_SECONDS_BETWEEN_ANALYSES=5

# Client Reply Drafting Configuration
MAX_DRAFTS_PER_SESSION=15
MIN_SECONDS_BETWEEN_DRAFTS=3

# Demo Quota Protection & Session Limits
MIN_SECONDS_BETWEEN_QUESTIONS=3
MAX_QUESTIONS_PER_SESSION=40
ANSWER_CACHE_TTL_SECONDS=1800
MAX_CHUNKS_PER_UPLOAD_BATCH=300
MAX_TOTAL_CHUNKS=1500
