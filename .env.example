GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Request Timeouts & Early Failover Settings
GEMINI_TIMEOUT_SECONDS=25
GEN_ANALYSIS_TIMEOUT_SECONDS=45
GEN_PRIMARY_ATTEMPTS=2
GEN_FALLBACK_ATTEMPTS=2
GEN_MAX_RETRIES=3
GEN_TOTAL_BUDGET_SECONDS=60
# GEN_THINKING_LEVEL=MINIMAL  # Optional: MINIMAL, LOW, MEDIUM, HIGH (unset = model default)
APP_TIMEZONE=Asia/Karachi

# Knowledge Insights & Analytics
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=data/analytics.db
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_MAX_EVENTS=5000
GAP_CLUSTER_COSINE=0.62
GAP_JACCARD=0.5

# Contract Analysis Configuration
MAX_ANALYSIS_CHARS=60000
MAX_ANALYSES_PER_SESSION=10
MIN_SECONDS_BETWEEN_ANALYSES=5

# Client Reply Drafting Configuration
MAX_DRAFTS_PER_SESSION=15
MIN_SECONDS_BETWEEN_DRAFTS=3

# Demo Quota Protection & Session Limits
MIN_SECONDS_BETWEEN_QUESTIONS=3
MAX_QUESTIONS_PER_SESSION=40
ANSWER_CACHE_TTL_SECONDS=1800
MAX_CHUNKS_PER_UPLOAD_BATCH=300
MAX_TOTAL_CHUNKS=1500

# Public Demo Mode & Session Upload Settings
DEMO_MODE=false
DEMO_MAX_UPLOAD_FILES_PER_SESSION=3
DEMO_MAX_CHUNKS_PER_SESSION=120
DEMO_MAX_TOTAL_SESSION_CHUNKS=3000
DEMO_MAX_UPLOAD_MB=5
SESSION_DOC_TTL_MINUTES=120
DEMO_DAILY_QUESTION_BUDGET=200
DEMO_DAILY_UPLOAD_EMBED_BUDGET=150
DEMO_DAILY_GENERATION_BUDGET=350
DEMO_DAILY_EMBED_BUDGET=600
DEMO_REAL_EVENT_RETENTION_HOURS=24
DEMO_QUOTA_TZ=America/Los_Angeles
DEMO_LIMITS_DB_PATH=data/demo_limits.db
